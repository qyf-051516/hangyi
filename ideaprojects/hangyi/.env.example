# ============================================
# 航翼排班 - 环境变量模板
# 复制为 .env 后填入实际值（cp .env.example .env）
# .env 在 .gitignore 中，不要提交
# ============================================

# JWT 签名密钥（gateway 和 auth 共用，必须一致）
# 生成方式: openssl rand -hex 32
JWT_SECRET=replace-with-64-char-hex

# 微服务间内部 API Key
# 生成方式: openssl rand -hex 32
INTERNAL_API_KEY=replace-with-64-char-hex

# 微信登录默认关闭；启用时必须配置小程序 AppID 和 AppSecret
WECHAT_LOGIN_ENABLED=false
WECHAT_APP_ID=
WECHAT_APP_SECRET=

# 航班模拟数据默认关闭，避免定时任务污染业务数据
FLIGHT_SYNC_SIMULATION_ENABLED=false
FLIGHT_SYNC_AUTO_ENABLED=false

# 本地端口矩阵（前端开发 5173 → 网关 9000 → Core 9001 / Schedule 9002 / Assistant 9004）
GATEWAY_PORT=9000
CORE_PORT=9001
SCHEDULE_PORT=9002
ASSISTANT_PORT=9004
VITE_DEV_PORT=5173
VITE_PREVIEW_PORT=9003
GATEWAY_HOST=localhost
CORE_HOST=localhost
SCHEDULE_HOST=localhost
ASSISTANT_HOST=localhost

# 可选完整地址覆盖（跨主机、HTTPS 或 E2E 环境使用）
# VITE_API_TARGET=http://localhost:9000
# HANGYI_WEB_URL=http://localhost:5173
# HANGYI_GATEWAY_URL=http://localhost:9000

# 数据库
DB_PASSWORD=123456

# Redis 密码（如果启用了 requirepass）
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=replace-with-32-char-hex

# Nacos 鉴权
NACOS_AUTH_TOKEN=replace-with-64-char-hex
NACOS_AUTH_IDENTITY_KEY=hangyi-nacos-local
NACOS_AUTH_IDENTITY_VALUE=replace-with-48-char-hex
NACOS_CONSOLE_USERNAME=hangyi_admin
NACOS_CONSOLE_PASSWORD=replace-with-32-char-hex

# CORS 白名单（多个 origin 用英文逗号分隔）
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:9003

# 智能知识问答
# 必须与小程序云 DB settings.assistantApiKey 一致
ASSISTANT_INTERNAL_KEY=replace-with-64-char-hex
ASSISTANT_INTERNAL_SIGNATURE_MAX_AGE=60s
# 完成数据库迁移、知识入库和 Recall@5 验收前保持 false
ASSISTANT_ENGINE_ENABLED=false
ASSISTANT_DEPENDENCY_PROBE_ENABLED=false

# Qdrant 向量库
QDRANT_URL=http://localhost:6333
QDRANT_API_KEY=replace-with-64-char-hex
QDRANT_COLLECTION=hangyi_business_knowledge

# Ollama 嵌入模型
OLLAMA_URL=http://localhost:11434
OLLAMA_EMBEDDING_MODEL=bge-m3
ASSISTANT_EMBEDDING_DIMENSION=1024

# 通义千问 OpenAI 兼容接口
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_API_KEY=
QWEN_CHAT_MODEL=qwen-plus

# 检索、配额与知识目录
ASSISTANT_TOP_K=5
ASSISTANT_SCORE_THRESHOLD=0.48
ASSISTANT_MAX_CONTEXT_CHARS=12000
ASSISTANT_MAX_ANSWER_TOKENS=900
ASSISTANT_EMPLOYEE_DAILY_QUOTA=20
ASSISTANT_ADMIN_DAILY_QUOTA=100
# 每个可信身份的短窗口上限，Redis 不可用时助手会拒绝请求以保护外部模型配额
ASSISTANT_EMPLOYEE_MINUTE_LIMIT=10
ASSISTANT_ADMIN_MINUTE_LIMIT=30
ASSISTANT_RATE_LIMIT_WINDOW=60s
ASSISTANT_KNOWLEDGE_PATH=knowledge/business
ASSISTANT_INGESTION_MODE=off
ASSISTANT_CONFIRM_FULL_REBUILD=false
ASSISTANT_EVALUATION_ENABLED=false
ASSISTANT_EVALUATION_PATH=knowledge/evaluation/questions.json
ASSISTANT_MIN_RECALL_AT5=0.85
