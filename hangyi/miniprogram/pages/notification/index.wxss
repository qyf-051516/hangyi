/* 页面、卡片、文字和状态基类由 app.wxss 提供 */

.header-card {
  border-top: 6rpx solid var(--c-primary);
}

.header-row {
  display: flex;
  align-items: flex-start;
  justify-content: space-between;
  gap: 16rpx;
}

.eyebrow {
  color: var(--c-primary);
  font-size: 22rpx;
  font-weight: 600;
}

.title {
  margin-top: 4rpx;
  font-size: 36rpx;
  font-weight: 700;
}

.sub {
  margin-top: 8rpx;
  color: var(--c-text-meta);
  font-size: 23rpx;
  line-height: 1.5;
}

.unread-badge {
  flex-shrink: 0;
  padding: 7rpx 14rpx;
  color: #ffffff;
  background: var(--c-danger);
  border-radius: var(--r-pill);
  font-size: 21rpx;
  font-weight: 600;
}

.mark-read {
  display: inline-flex;
  align-items: center;
  margin-top: 10rpx;
  color: var(--c-primary);
  font-size: 23rpx;
  font-weight: 600;
}

.filter-scroll {
  width: 100%;
  margin-bottom: var(--gap-card);
  white-space: nowrap;
}

.filter-row {
  display: inline-flex;
  gap: 10rpx;
  padding-right: 22rpx;
}

.filter-chip {
  display: inline-flex;
  min-height: 68rpx;
  align-items: center;
  padding: 0 24rpx;
  color: var(--c-text-meta);
  background: var(--c-surface);
  border: 1rpx solid var(--c-border);
  border-radius: var(--r-pill);
  font-size: 23rpx;
  transition: opacity 0.15s ease, transform 0.08s ease;
}

.filter-chip.active {
  color: #ffffff;
  background: var(--c-primary);
  border-color: var(--c-primary);
  font-weight: 600;
}

.loading-card {
  align-items: stretch;
  text-align: left;
}

.skeleton-title {
  width: 34%;
  height: 38rpx;
}

.skeleton-item {
  width: 100%;
  height: 152rpx;
  margin-top: 20rpx;
}

.skeleton-item.short {
  width: 78%;
}

.notification-item {
  position: relative;
  padding: 20rpx;
  margin-bottom: 14rpx;
  background: var(--c-surface);
  border: 1rpx solid var(--c-border);
  border-radius: var(--r-card);
  box-shadow: var(--sh-card);
  transition: opacity 0.15s ease, transform 0.08s ease;
}

.notification-item.unread {
  border-left: 6rpx solid var(--c-primary);
}

.item-head,
.item-footer {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 14rpx;
}

.item-tags {
  display: flex;
  flex-wrap: wrap;
  gap: 8rpx;
}

.category,
.status {
  display: inline-flex;
  min-height: 42rpx;
  align-items: center;
  padding: 0 12rpx;
  border-radius: var(--r-pill);
  font-size: 20rpx;
  font-weight: 600;
}

.category {
  color: var(--c-primary);
  background: rgba(47, 125, 255, 0.1);
}

.status {
  color: var(--c-text-meta);
  background: rgba(95, 115, 145, 0.1);
}

.status-PENDING {
  color: var(--c-warn);
  background: rgba(194, 138, 39, 0.12);
}

.status-APPROVED {
  color: var(--c-success);
  background: rgba(46, 212, 106, 0.12);
}

.status-REJECTED {
  color: var(--c-danger);
  background: rgba(201, 75, 86, 0.12);
}

.item-dot {
  width: 14rpx;
  height: 14rpx;
  flex-shrink: 0;
  background: var(--c-danger);
  border-radius: 50%;
}

.message {
  margin-top: 14rpx;
  font-size: 29rpx;
  font-weight: 700;
}

.summary {
  margin-top: 7rpx;
  overflow: hidden;
  color: var(--c-text-meta);
  font-size: 23rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.item-footer {
  min-height: 64rpx;
  margin-top: 10rpx;
  border-top: 1rpx solid var(--c-border);
}

.notification-time {
  color: var(--c-text-muted);
  font-size: 20rpx;
}

.detail-toggle,
.request-link {
  color: var(--c-primary);
  font-size: 22rpx;
  font-weight: 600;
}

.detail-panel {
  padding-top: 12rpx;
  border-top: 1rpx solid var(--c-border);
}

.detail-row {
  display: flex;
  gap: 18rpx;
  padding: 9rpx 0;
  font-size: 23rpx;
  line-height: 1.5;
}

.detail-label {
  width: 118rpx;
  flex-shrink: 0;
  color: var(--c-text-muted);
}

.detail-value {
  flex: 1;
  min-width: 0;
  word-break: break-all;
}

.request-link {
  display: flex;
  align-items: center;
  justify-content: flex-end;
  margin-top: 8rpx;
}

.empty-mark {
  display: inline-flex;
  width: 64rpx;
  height: 64rpx;
  align-items: center;
  justify-content: center;
  margin-bottom: 16rpx;
  color: var(--c-primary);
  background: rgba(47, 125, 255, 0.1);
  border-radius: 50%;
  font-size: 25rpx;
  font-weight: 700;
}

.empty-actions {
  display: flex;
  justify-content: center;
}
