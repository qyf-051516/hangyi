/* leave - 复用 .page .card .t-* 基类 (app.wxss 提供) */

.form-card { padding: 22rpx 24rpx; }
.form-title { font-size: 30rpx; font-weight: 600; color: var(--c-text); margin-bottom: 14rpx; }
.form-row {
  display: flex;
  align-items: center;
  padding: 14rpx 0;
  border-bottom: 1rpx solid var(--c-border);
  gap: 14rpx;
}
.form-row.column {
  flex-direction: column;
  align-items: stretch;
  border-bottom: none;
  padding-bottom: 6rpx;
}
.form-row.column .form-label { margin-bottom: 8rpx; }
.form-label {
  font-size: 26rpx;
  color: var(--c-text-meta);
  flex-shrink: 0;
  min-width: 80rpx;
}
.form-input {
  flex: 1;
  font-size: 28rpx;
  color: var(--c-text);
  background: transparent;
  min-height: 64rpx;
  line-height: 64rpx;
}
.form-input.picker { color: var(--c-text); }
.form-input.readonly { color: var(--c-text-meta); }
.form-textarea {
  width: 100%;
  min-height: 140rpx;
  font-size: 28rpx;
  color: var(--c-text);
  background: var(--c-surface-solid);
  border: 1rpx solid var(--c-border);
  border-radius: var(--r-chip);
  padding: 16rpx;
  box-sizing: border-box;
}
.reason-help {
  color: var(--c-text-muted);
  font-size: 22rpx;
}
.image-grid,
.request-images {
  display: flex;
  flex-wrap: wrap;
  gap: 12rpx;
  margin-top: 14rpx;
}
.image-item {
  position: relative;
  width: 152rpx;
  height: 152rpx;
}
.reason-image,
.request-image {
  width: 152rpx;
  height: 152rpx;
  border: 1rpx solid var(--c-border);
  border-radius: 14rpx;
}
.request-image {
  width: 120rpx;
  height: 120rpx;
}
.image-remove {
  position: absolute;
  right: 6rpx;
  top: 6rpx;
  min-width: 64rpx;
  min-height: 64rpx;
  padding: 0 12rpx;
  color: #ffffff;
  background: rgba(24, 39, 59, 0.82);
  border-radius: 999rpx;
  font-size: 20rpx;
  line-height: 64rpx;
  text-align: center;
}
.image-add {
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  width: 152rpx;
  min-height: 152rpx;
  color: var(--c-primary);
  background: var(--c-surface-solid);
  border: 1rpx dashed var(--c-primary);
  border-radius: 14rpx;
  font-size: 22rpx;
}
.image-add-mark {
  margin-bottom: 4rpx;
  font-size: 40rpx;
  line-height: 1;
}
.submit-btn {
  margin-top: 22rpx;
  min-height: 80rpx;
  line-height: 80rpx;
}

.list-card { padding: 22rpx 24rpx; }
.list-title {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--c-text);
  margin-bottom: 14rpx;
}
.empty-text, .loading-text {
  text-align: center;
  color: var(--c-text-muted);
  font-size: 26rpx;
  padding: 30rpx 0;
}
.leave-item {
  padding: 18rpx 0;
  border-bottom: 1rpx solid var(--c-border);
}
.leave-item:last-child { border-bottom: none; }
.leave-head {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 12rpx;
}
.leave-type {
  font-size: 30rpx;
  font-weight: 600;
  color: var(--c-text);
}
.leave-status {
  font-size: 22rpx;
  padding: 4rpx 14rpx;
  border-radius: 999rpx;
  color: #fff;
}
.leave-status-PENDING { background: var(--c-warn); }
.leave-status-APPROVED { background: var(--c-success); }
.leave-status-REJECTED { background: var(--c-danger); }
.leave-status-CANCELLED { background: var(--c-text-muted); }
.leave-dates {
  font-size: 26rpx;
  color: var(--c-text-body);
  margin-top: 6rpx;
}
.leave-reason {
  font-size: 24rpx;
  color: var(--c-text-meta);
  margin-top: 6rpx;
}
.leave-foot {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-top: 10rpx;
  gap: 10rpx;
}
.leave-time {
  font-size: 22rpx;
  color: var(--c-text-muted);
}
.withdraw-btn {
  min-height: 64rpx;
  line-height: 64rpx;
  padding: 0 22rpx;
  font-size: 24rpx;
}
.leave-comment {
  margin-top: 8rpx;
  padding: 10rpx 14rpx;
  background: var(--c-surface-solid);
  border: 1rpx solid var(--c-border);
  border-radius: var(--r-chip);
  font-size: 24rpx;
  color: var(--c-text-meta);
}
.validation-line {
  margin-top: 12rpx;
  padding: 10rpx 14rpx;
  color: var(--c-primary);
  background: rgba(47, 125, 255, 0.1);
  border-radius: var(--r-chip);
  font-size: 22rpx;
  line-height: 1.5;
}
.audit-block {
  margin-top: 14rpx;
  padding: 14rpx;
  background: var(--c-surface-solid);
  border: 1rpx solid var(--c-border);
  border-radius: var(--r-chip);
}
.audit-title {
  margin-bottom: 8rpx;
  color: var(--c-text);
  font-size: 23rpx;
  font-weight: 600;
}
.audit-row {
  display: flex;
  gap: 10rpx;
  padding: 6rpx 0;
  color: var(--c-text-meta);
  font-size: 22rpx;
}
.audit-dot {
  width: 10rpx;
  height: 10rpx;
  margin-top: 11rpx;
  background: var(--c-primary);
  border-radius: 999rpx;
  flex: 0 0 auto;
}
.audit-meta {
  margin-top: 2rpx;
  color: var(--c-text-muted);
  line-height: 1.45;
}

.approval-filter-card {
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
  padding: 18rpx 24rpx;
}
.filter-label {
  color: var(--c-text-meta);
  font-size: 26rpx;
}
.filter-picker {
  min-width: 220rpx;
}
.filter-value {
  min-height: 64rpx;
  line-height: 64rpx;
  padding: 0 22rpx;
  text-align: center;
  color: var(--c-primary);
  background: var(--c-surface-solid);
  border: 1rpx solid var(--c-border-strong);
  border-radius: var(--r-chip);
  font-size: 26rpx;
}
.employee-no {
  margin-left: 12rpx;
  color: var(--c-text-muted);
  font-size: 24rpx;
}
.approval-time {
  display: block;
  margin-top: 10rpx;
}
.approval-actions {
  display: flex;
  justify-content: flex-end;
  gap: 16rpx;
  margin-top: 16rpx;
}
.approval-btn {
  width: 180rpx;
  min-height: 68rpx;
  line-height: 68rpx;
  padding: 0 20rpx;
  border-radius: var(--r-chip);
  font-size: 26rpx;
}
.approval-btn::after {
  border: none;
}
.reject-btn {
  color: var(--c-danger);
  background: transparent;
  border: 1rpx solid var(--c-danger);
}
.approve-btn {
  color: #ffffff;
  background: var(--c-success);
  border: 1rpx solid var(--c-success);
}
.denied-card,
.approval-error { padding: 42rpx 24rpx; text-align: center; }
.state-title { font-size: 29rpx; font-weight: 750; }
.state-copy { margin-top: 9rpx; font-size: 21rpx; line-height: 1.5; opacity: 0.65; }
.state-btn {
  margin-top: 22rpx;
  min-height: 68rpx;
  line-height: 68rpx;
  border-radius: 14rpx;
  color: #ffffff;
  background: #285f96;
  font-size: 24rpx;
}
