
/* 主题 / 页面 / 卡片基类由 app.wxss 提供(.page / .card / .t-* / .c-*) */

.head .title { font-size: 32rpx; font-weight: 700; }
.head .sub { font-size: 22rpx; margin-top: 6rpx; }
.theme-dark .head .sub { color: #9abde3; }
.theme-light .head .sub { color: #3d5270; }

.date-picker { margin-top: 14rpx; }
.date-btn {
  display: inline-flex;
  align-items: center;
  min-height: 64rpx;
  padding: 0 24rpx;
  font-size: 24rpx;
  border-radius: 12rpx;
}
.theme-dark .date-btn { background: rgba(83, 153, 255, 0.12); color: #5399ff; border: 1rpx solid rgba(83, 153, 255, 0.3); }
.theme-light .date-btn { background: rgba(83, 153, 255, 0.06); color: #245090; border: 1rpx solid rgba(83, 153, 255, 0.2); }

/* 统计 */
.sh-stats { display: flex; gap: 20rpx; }
.sh-stat { flex: 1; text-align: center; }
.sh-stat-num { display: block; font-size: 40rpx; font-weight: 800; }
.sh-active { color: #2ed46a; }
.sh-archived { color: #f0a030; }
.sh-pub { color: #5399ff; }
.sh-stat-lbl { display: block; font-size: 20rpx; margin-top: 4rpx; }
.theme-dark .sh-stat-lbl { color: #9abde3; }
.theme-light .sh-stat-lbl { color: #3d5270; }

.section-title { font-size: 26rpx; font-weight: 700; padding-bottom: 10rpx; display: flex; justify-content: space-between; align-items: center; }
.toggle-arrow { font-size: 24rpx; }
.archive-toggle { min-height: 64rpx; padding-bottom: 0; }

/* 发布记录 */
.ph-item { display: flex; gap: 14rpx; padding: 12rpx 0; border-left: 2rpx solid; padding-left: 20rpx; margin-left: 8rpx; position: relative; }
.theme-dark .ph-item { border-color: rgba(84, 170, 255, 0.15); }
.theme-light .ph-item { border-color: rgba(124, 156, 198, 0.2); }
.ph-item:last-child { border-left: none; }
.ph-dot {
  position: absolute; left: -7rpx; top: 16rpx;
  width: 12rpx; height: 12rpx; border-radius: 50%;
  background: #5399ff;
}
.ph-info { flex: 1; }
.ph-action { font-size: 26rpx; font-weight: 700; display: block; }
.ph-detail { font-size: 22rpx; display: block; margin-top: 4rpx; }
.theme-dark .ph-detail { color: #9abde3; }
.theme-light .ph-detail { color: #3d5270; }
.ph-time { font-size: 20rpx; display: block; margin-top: 4rpx; }
.theme-dark .ph-time { color: #6e9fc9; }
.theme-light .ph-time { color: #6e88ad; }

.schedule-list { display: flex; flex-direction: column; gap: 10rpx; }
.schedule-row { padding: 15rpx; border-radius: 14rpx; }
.theme-light .schedule-row { background: #edf5fd; }
.theme-dark .schedule-row { background: #123351; }
.schedule-row-head,
.schedule-meta { display: flex; align-items: center; justify-content: space-between; gap: 12rpx; }
.schedule-name { font-size: 25rpx; font-weight: 720; }
.schedule-no { margin-left: 10rpx; font-size: 19rpx; opacity: 0.58; }
.schedule-status {
  padding: 5rpx 11rpx;
  border-radius: 8rpx;
  color: #266295;
  background: rgba(52, 125, 190, 0.12);
  font-size: 19rpx;
  font-weight: 650;
}
.archived-status { color: #9a651a; background: rgba(199, 132, 35, 0.13); }
.schedule-meta { margin-top: 9rpx; font-size: 20rpx; opacity: 0.68; }
.archive-time { margin-top: 7rpx; font-size: 19rpx; opacity: 0.52; }
.archived-list { margin-top: 8rpx; }

.sh-empty { text-align: center; padding: 40rpx 0; font-size: 24rpx; }
.theme-dark .sh-empty { color: #6e9fc9; }
.theme-light .sh-empty { color: #6e88ad; }

.sh-hint { text-align: center; font-size: 22rpx; padding: 10rpx; }
.theme-dark .sh-hint { color: #6e9fc9; }
.theme-light .sh-hint { color: #6e88ad; }

.loading-text { text-align: center; padding: 40rpx; font-size: 26rpx; }
.theme-dark .loading-text { color: #9abde3; }
.theme-light .loading-text { color: #3d5270; }

/* ===== 权限不足提示 ===== */
.denied-card {
  text-align: center;
  padding: 80rpx 40rpx;
  margin-top: 80rpx;
}
.denied-icon { font-size: 80rpx; margin-bottom: 16rpx; }
.denied-title { font-size: 32rpx; font-weight: 600; margin-bottom: 8rpx; }
.denied-sub { font-size: 24rpx; opacity: 0.7; }
.error-card { text-align: center; padding: 42rpx 24rpx; }
.state-btn {
  margin-top: 22rpx;
  min-height: 70rpx;
  line-height: 70rpx;
  border-radius: 14rpx;
  color: #ffffff;
  background: #285f96;
  font-size: 24rpx;
}
.theme-dark .denied-title { color: #dff6ff; }
.theme-light .denied-title { color: #17355f; }
.theme-dark .denied-sub { color: #9abde3; }
.theme-light .denied-sub { color: #3d5270; }
