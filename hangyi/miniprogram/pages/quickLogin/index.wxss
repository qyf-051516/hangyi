/* quickLogin - 复用 auth 配色 + 增加品牌头 + 2 个大按钮 */
/* quickLogin 局部微调(基类由 app.wxss 提供) */
.page { display: flex; flex-direction: column; align-items: stretch; justify-content: flex-start; }

.brand {
  display: flex;
  flex-direction: column;
  align-items: center;
  padding: 48rpx 0 28rpx;
}

.brand-title {
  font-size: 44rpx;
  font-weight: 800;
  letter-spacing: 4rpx;
  margin-bottom: 8rpx;
}

.brand-sub {
  font-size: 24rpx;
  opacity: 0.7;
}

.card {
  border-radius: 24rpx;
  padding: 32rpx 24rpx;
  margin-bottom: 24rpx;
}

.theme-dark .card {
  background: rgba(14, 35, 66, 0.88);
  border: 1rpx solid rgba(84, 170, 255, 0.35);
}

.theme-light .card {
  background: rgba(234, 245, 255, 0.92);
  border: 1rpx solid rgba(124, 156, 198, 0.4);
}

.card-title {
  font-size: 28rpx;
  font-weight: 700;
  margin-bottom: 8rpx;
}

.card-sub {
  font-size: 22rpx;
  opacity: 0.7;
  margin-bottom: 24rpx;
  line-height: 1.5;
}

.primary-btn {
  height: 88rpx;
  line-height: 88rpx;
  font-size: 30rpx;
  font-weight: 600;
  border-radius: 16rpx;
  background: linear-gradient(90deg, #2ed8ff 0%, #5399ff 100%);
  color: #fff;
  border: none;
}

.primary-btn[disabled] {
  opacity: 0.5;
}

.secondary-btn {
  height: 88rpx;
  line-height: 88rpx;
  font-size: 28rpx;
  border-radius: 16rpx;
  background: transparent;
  border: 1rpx solid rgba(89, 168, 255, 0.5);
  color: inherit;
  margin-top: 16rpx;
}

.theme-light .secondary-btn {
  border-color: rgba(83, 153, 255, 0.5);
  color: #245090;
}

.divider {
  display: flex;
  align-items: center;
  margin: 24rpx 0;
  opacity: 0.6;
}

.divider::before,
.divider::after {
  content: "";
  flex: 1;
  height: 1rpx;
  background: currentColor;
  opacity: 0.3;
}

.divider-text {
  padding: 0 20rpx;
  font-size: 22rpx;
}

.foot {
  margin-top: auto;
  padding: 32rpx 0;
  text-align: center;
  font-size: 22rpx;
  opacity: 0.5;
}
