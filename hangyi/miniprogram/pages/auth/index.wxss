
/* 主题 / 页面 / 卡片基类由 app.wxss 提供(.page / .card / .t-* / .c-*) */

.title {
  font-size: 34rpx;
  font-weight: 700;
}

.sub {
  margin-top: 10rpx;
  margin-bottom: 20rpx;
  font-size: 24rpx;
  color: #9abde3;
  line-height: 1.6;
}

.field {
  margin-bottom: 16rpx;
}

.admin-field {
  display: flex;
  align-items: center;
  justify-content: space-between;
}

.label {
  margin-bottom: 8rpx;
  font-size: 24rpx;
  color: #b3d4f9;
}

.input {
  height: 72rpx;
  line-height: 72rpx;
  padding: 0 16rpx;
  background: rgba(17, 43, 77, 0.9);
  border: 1rpx solid rgba(89, 168, 255, 0.35);
  border-radius: 12rpx;
  font-size: 26rpx;
}

.submit-btn {
  margin-top: 24rpx;
  height: 72rpx;
  line-height: 72rpx;
  width: auto;
  min-width: 0;
  padding: 0 16rpx;
  background: rgba(46, 222, 255, 0.22);
  color: #dff6ff;
  border: 1rpx solid rgba(77, 232, 255, 0.5);
  border-radius: 14rpx;
  font-size: 26rpx;
}

.theme-light .sub,
.theme-light .label {
  color: #3d5270;
}

.theme-light .input {
  background: rgba(240, 247, 255, 0.95);
  border: 1rpx solid rgba(124, 156, 198, 0.42);
  color: #17355f;
}

.theme-light .submit-btn {
  background: rgba(83, 153, 255, 0.12);
  color: #245090;
  border: 1rpx solid rgba(83, 153, 255, 0.4);
}
