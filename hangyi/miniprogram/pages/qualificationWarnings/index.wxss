.page { padding: 16px; min-height: 100vh; }
.page.theme-light { background: #e8f4ff; }
.theme-dark { background: #1a1a2e; color: #e0e0e0; }

.card { background: #fff; border-radius: 12px; padding: 16px; margin-bottom: 12px; box-shadow: 0 2px 8px rgba(0,0,0,.06); }
.theme-dark .card { background: #252540; box-shadow: 0 2px 8px rgba(0,0,0,.2); }

/* 摘要 */
.summary-title { font-size: 15px; font-weight: 600; margin-bottom: 12px; color: #333; }
.theme-dark .summary-title { color: #e0e0e0; }
.summary-row { display: flex; justify-content: space-between; }
.summary-item { flex: 1; text-align: center; }
.sum-num { font-size: 24px; font-weight: 700; display: block; }
.sum-lbl { font-size: 12px; color: #888; margin-top: 4px; display: block; }
.sum-num-red { color: #e74c3c; }
.sum-num-orange { color: #e67e22; }
.sum-num-yellow { color: #f39c12; }
.sum-num-green { color: #27ae60; }

/* 提示 */
.hint-text { font-size: 13px; color: #888; }
.theme-dark .hint-text { color: #aaa; }

/* 人员卡片 */
.staff-card { padding: 12px 16px; }
.staff-header { display: flex; justify-content: space-between; align-items: center; }
.staff-info { flex: 1; }
.staff-name { font-size: 16px; font-weight: 600; color: #333; }
.theme-dark .staff-name { color: #e0e0e0; }
.staff-meta { font-size: 12px; color: #888; margin-left: 8px; }
.theme-dark .staff-meta { color: #aaa; }
.staff-badge-wrap { display: flex; align-items: center; gap: 8px; }
.expand-icon { font-size: 11px; color: #999; }

/* 资质徽章 */
.qual-badge { display: inline-block; padding: 2px 8px; border-radius: 10px; font-size: 11px; font-weight: 600; }
.badge-expired { background: #fde8e8; color: #e74c3c; }
.badge-expiring30 { background: #fef0e6; color: #e67e22; }
.badge-expiring60 { background: #fef9e7; color: #f39c12; }
.badge-valid { background: #e8f8ef; color: #27ae60; }
.theme-dark .badge-expired { background: #3d2020; color: #ff6b6b; }
.theme-dark .badge-expiring30 { background: #3d2d1a; color: #ffa94d; }
.theme-dark .badge-expiring60 { background: #3d3520; color: #ffd43b; }
.theme-dark .badge-valid { background: #1a3d2a; color: #69db7c; }

/* 资质详情 */
.qual-detail { margin-top: 12px; border-top: 1px solid #eee; padding-top: 12px; }
.theme-dark .qual-detail { border-color: #333; }
.qual-item { display: flex; justify-content: space-between; align-items: center; padding: 8px 0; border-bottom: 1px solid #f5f5f5; }
.theme-dark .qual-item { border-color: #333; }
.qual-item:last-child { border-bottom: none; }
.qual-left { display: flex; flex-direction: column; }
.qual-type { font-size: 14px; font-weight: 600; color: #333; }
.theme-dark .qual-type { color: #e0e0e0; }
.qual-cert { font-size: 11px; color: #999; }
.qual-right { text-align: right; display: flex; flex-direction: column; align-items: flex-end; gap: 4px; }
.qual-expiry { font-size: 12px; color: #888; }

/* 申请培训假按钮（30 天内即将到期） */
.qual-train-btn {
  min-height: 64rpx;
  line-height: 64rpx;
  padding: 0 24rpx;
  margin-top: 8rpx;
  font-size: 22rpx;
  color: var(--c-primary);
  background: var(--c-surface-solid);
  border: 1rpx solid var(--c-primary);
  border-radius: var(--r-chip);
  text-align: center;
  white-space: nowrap;
}

.loading-wrap, .empty-wrap, .error-wrap { display: flex; flex-direction: column; align-items: center; justify-content: center; padding: 40px; }
.loading-text, .empty-text { color: #999; font-size: 14px; }
.retry-btn {
  margin-top: 18rpx;
  min-height: 68rpx;
  line-height: 68rpx;
  padding: 0 30rpx;
  border-radius: 14rpx;
  color: #ffffff;
  background: #285f96;
  font-size: 23rpx;
}
