<view class="page {{themeClass}}">
  <!-- 统计摘要 -->
  <view class="card summary-card">
    <view class="summary-title">资质预警概况</view>
    <view class="summary-row">
      <view class="summary-item">
        <text class="sum-num sum-num-red">{{summary.expired}}</text>
        <text class="sum-lbl">已过期</text>
      </view>
      <view class="summary-item">
        <text class="sum-num sum-num-orange">{{summary.expiring30}}</text>
        <text class="sum-lbl">30天内到期</text>
      </view>
      <view class="summary-item">
        <text class="sum-num sum-num-yellow">{{summary.expiring60}}</text>
        <text class="sum-lbl">60天内到期</text>
      </view>
      <view class="summary-item">
        <text class="sum-num sum-num-green">{{summary.valid}}</text>
        <text class="sum-lbl">正常</text>
      </view>
    </view>
  </view>

  <!-- 搜索提示 -->
  <view class="card hint-card" wx:if="{{list.length > 0}}">
    <text class="hint-text">
      {{scope === 'ALL' ? '全部人员' : '我的资质'}} · 按到期天数排序
    </text>
  </view>

  <!-- 列表 -->
  <view class="list" wx:if="{{!loading && list.length > 0}}">
    <view class="card staff-card" wx:for="{{list}}" wx:key="employeeNo" data-staff-id="{{item.employeeNo}}" bindtap="onToggleExpand">
      <view class="staff-header">
        <view class="staff-info">
          <text class="staff-name">{{item.name}}</text>
          <text class="staff-meta">{{item.employeeNo}} · {{item.groupText}}</text>
        </view>
        <view class="staff-badge-wrap">
          <view class="qual-badge {{item.minDaysLeft < 0 ? 'badge-expired' : item.minDaysLeft <= 30 ? 'badge-expiring30' : item.minDaysLeft <= 60 ? 'badge-expiring60' : 'badge-valid'}}">
            {{item.minDaysLeft < 0 ? '已过期' : item.minDaysLeft <= 30 ? '紧急' : item.minDaysLeft <= 60 ? '关注' : '正常'}}
          </view>
          <text class="expand-icon">{{expandStaffId === item.employeeNo ? '收起' : '展开'}}</text>
        </view>
      </view>
      <!-- 展开详情 -->
      <view class="qual-detail" wx:if="{{expandStaffId === item.employeeNo}}">
        <view class="qual-item" wx:for="{{item.qualifications}}" wx:key="certNo">
          <view class="qual-left">
            <text class="qual-type">{{item.aircraftType}}</text>
            <text class="qual-cert">编号: {{item.certNo}}</text>
          </view>
          <view class="qual-right">
            <text class="qual-expiry">到期: {{item.validUntil}}</text>
            <view class="qual-badge {{item.daysLeft < 0 ? 'badge-expired' : item.daysLeft <= 30 ? 'badge-expiring30' : item.daysLeft <= 60 ? 'badge-expiring60' : 'badge-valid'}}">
              {{item.daysText}}
            </view>
            <view
              class="qual-train-btn"
              wx:if="{{item.daysLeft >= 0 && item.daysLeft <= 30}}"
              data-aircraft="{{item.aircraftType}}"
              data-expire-date="{{item.validUntil}}"
              catchtap="onApplyTrainingLeave"
              hover-class="tap-active"
            >申请培训假</view>
          </view>
        </view>
      </view>
    </view>
  </view>

  <!-- 加载 -->
  <view class="card loading-wrap" wx:if="{{loading}}">
    <text class="loading-text">加载中...</text>
  </view>

  <view class="card error-wrap" wx:elif="{{errorMessage}}">
    <text class="empty-text">{{errorMessage}}</text>
    <button class="retry-btn" bindtap="onRetry" hover-class="button-hover">重新加载</button>
  </view>

  <!-- 空状态 -->
  <view class="card empty-wrap" wx:if="{{!loading && !errorMessage && list.length === 0}}">
    <text class="empty-text">暂无资质数据</text>
  </view>
</view>
