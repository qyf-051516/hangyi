/* 页面与卡片基类由 app.wxss 提供 */

.profile-module {
  margin-bottom: 18rpx;
}

.profile-hero {
  position: relative;
  min-height: 190rpx;
  padding: 28rpx 26rpx 72rpx;
  overflow: hidden;
  box-sizing: border-box;
  color: #ffffff;
  background: linear-gradient(135deg, #3d9cff 0%, #1178ee 100%);
  border-radius: 20rpx 20rpx 16rpx 16rpx;
  box-shadow: 0 16rpx 38rpx rgba(17, 120, 238, 0.22);
}

.profile-hero::after {
  position: absolute;
  top: -54rpx;
  right: -20rpx;
  width: 220rpx;
  height: 220rpx;
  content: "";
  border: 2rpx solid rgba(255, 255, 255, 0.15);
  border-radius: 50%;
}

.profile-row {
  position: relative;
  z-index: 1;
  display: flex;
  align-items: center;
  gap: 18rpx;
}

.avatar {
  width: 96rpx;
  height: 96rpx;
  flex-shrink: 0;
  background: #ffffff;
  border: 6rpx solid rgba(255, 255, 255, 0.72);
  border-radius: 50%;
  box-shadow: 0 8rpx 20rpx rgba(0, 65, 154, 0.18);
}

.profile-info {
  flex: 1;
  min-width: 0;
}

.name {
  overflow: hidden;
  color: #ffffff;
  font-size: 33rpx;
  font-weight: 700;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.profile-role {
  margin-top: 7rpx;
  overflow: hidden;
  color: rgba(255, 255, 255, 0.82);
  font-size: 22rpx;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.verified-pill {
  display: inline-flex;
  min-width: 106rpx;
  min-height: 56rpx;
  flex-shrink: 0;
  align-items: center;
  justify-content: center;
  padding: 0 16rpx;
  box-sizing: border-box;
  color: #155da9;
  background: #ffffff;
  border-radius: var(--r-pill);
  font-size: 21rpx;
  font-weight: 600;
}

.identity-strip {
  position: relative;
  z-index: 2;
  display: flex;
  min-height: 136rpx;
  margin: -54rpx 6rpx 0;
  padding: 18rpx 4rpx;
  box-sizing: border-box;
  background: #ffffff;
  border: 1rpx solid var(--c-border);
  border-radius: 16rpx;
  box-shadow: var(--sh-card);
}

.identity-item {
  display: flex;
  flex: 1;
  min-width: 0;
  flex-direction: column;
  align-items: center;
}

.identity-icon {
  width: 38rpx;
  height: 38rpx;
  padding: 7rpx;
  box-sizing: border-box;
  background: rgba(17, 120, 238, 0.08);
  border-radius: 9rpx;
}

.identity-label {
  margin-top: 6rpx;
  color: var(--c-text-muted);
  font-size: 19rpx;
}

.identity-value {
  max-width: 100%;
  margin-top: 3rpx;
  overflow: hidden;
  color: var(--c-text);
  font-size: 21rpx;
  font-weight: 700;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.qr-banner {
  position: relative;
  display: flex;
  min-height: 126rpx;
  align-items: center;
  justify-content: space-between;
  padding: 22rpx 24rpx;
  margin-bottom: 18rpx;
  overflow: hidden;
  box-sizing: border-box;
  color: #ffffff;
  background: linear-gradient(105deg, #258af4 0%, #0571e7 100%);
  border-radius: 16rpx;
  box-shadow: 0 12rpx 28rpx rgba(17, 120, 238, 0.18);
  transition: opacity 0.15s ease, transform 0.08s ease;
}

.qr-title {
  font-size: 28rpx;
  font-weight: 700;
}

.qr-copy {
  margin-top: 6rpx;
  color: rgba(255, 255, 255, 0.78);
  font-size: 20rpx;
}

.qr-symbol {
  display: inline-flex;
  width: 72rpx;
  height: 72rpx;
  flex-shrink: 0;
  align-items: center;
  justify-content: center;
  color: #ffffff;
  background: rgba(255, 255, 255, 0.13);
  border: 1rpx solid rgba(255, 255, 255, 0.34);
  border-radius: 12rpx;
}

.qr-symbol-image {
  width: 48rpx;
  height: 48rpx;
}

.login-prompt {
  padding: 42rpx 24rpx;
  text-align: center;
}

.prompt-code {
  display: inline-flex;
  width: 74rpx;
  height: 74rpx;
  align-items: center;
  justify-content: center;
  margin-bottom: 16rpx;
  color: #ffffff;
  background: var(--c-primary);
  border-radius: 20rpx;
}

.prompt-logo {
  width: 44rpx;
  height: 44rpx;
}

.prompt-title {
  font-size: 31rpx;
  font-weight: 700;
}

.prompt-sub {
  margin: 10rpx auto 22rpx;
  color: var(--c-text-meta);
  font-size: 22rpx;
  line-height: 1.6;
}

.bind-btn {
  min-width: 240rpx;
  height: 72rpx;
  margin: 0 auto;
  color: #ffffff;
  background: var(--c-primary);
  border-radius: 12rpx;
  font-size: 25rpx;
}

.menu-card {
  padding: 0;
  overflow: hidden;
  background: var(--c-surface-solid);
}

.menu-item {
  position: relative;
  display: flex;
  min-height: 104rpx;
  align-items: center;
  gap: 16rpx;
  padding: 12rpx 22rpx;
  box-sizing: border-box;
  border-bottom: 1rpx solid #e7eff7;
  transition: opacity 0.15s ease, transform 0.08s ease;
}

.menu-item:last-child {
  border-bottom: 0;
}

.menu-icon {
  display: inline-flex;
  width: 54rpx;
  height: 54rpx;
  flex-shrink: 0;
  align-items: center;
  justify-content: center;
  color: var(--c-primary);
  background: rgba(17, 120, 238, 0.1);
  border-radius: 14rpx;
}

.menu-icon-image {
  width: 30rpx;
  height: 30rpx;
}

.menu-icon.tone-green {
  color: #14aa75;
  background: rgba(20, 170, 117, 0.12);
}

.menu-icon.tone-coral {
  color: #e9576c;
  background: rgba(233, 87, 108, 0.11);
}

.menu-icon.tone-violet {
  color: #745ce7;
  background: rgba(116, 92, 231, 0.11);
}

.menu-icon.tone-amber {
  color: #d98618;
  background: rgba(217, 134, 24, 0.12);
}

.menu-icon.tone-slate {
  color: #52677f;
  background: rgba(82, 103, 127, 0.1);
}

.menu-content {
  display: flex;
  flex: 1;
  min-width: 0;
  flex-direction: column;
}

.menu-title {
  color: var(--c-text);
  font-size: 26rpx;
  font-weight: 600;
}

.menu-subtitle {
  margin-top: 4rpx;
  overflow: hidden;
  color: var(--c-text-muted);
  font-size: 20rpx;
  line-height: 1.4;
  text-overflow: ellipsis;
  white-space: nowrap;
}

.menu-arrow {
  width: 28rpx;
  height: 28rpx;
  flex-shrink: 0;
  background: url("/images/menu/chevron-right-muted.svg") center / 24rpx 24rpx no-repeat;
  font-size: 0;
}

.admin-hub {
  position: relative;
  display: flex;
  align-items: center;
  gap: 18rpx;
  min-height: 148rpx;
  padding: 24rpx;
  margin: 18rpx 0;
  overflow: hidden;
  box-sizing: border-box;
  color: #ffffff;
  background: #166fd0;
  border-radius: 18rpx;
  box-shadow: 0 14rpx 32rpx rgba(22, 111, 208, 0.22);
  transition: opacity 0.15s ease, transform 0.08s ease;
}

.admin-hub::after {
  position: absolute;
  right: -42rpx;
  bottom: -78rpx;
  width: 210rpx;
  height: 210rpx;
  content: "";
  border: 2rpx solid rgba(255, 255, 255, 0.12);
  border-radius: 50%;
}

.admin-hub-icon {
  position: relative;
  z-index: 1;
  display: flex;
  width: 76rpx;
  height: 76rpx;
  flex-shrink: 0;
  align-items: center;
  justify-content: center;
  background: rgba(255, 255, 255, 0.94);
  border-radius: 20rpx;
}

.admin-hub-icon-image {
  width: 42rpx;
  height: 42rpx;
}

.admin-hub-content {
  position: relative;
  z-index: 1;
  flex: 1;
  min-width: 0;
}

.admin-hub-kicker {
  color: rgba(255, 255, 255, 0.72);
  font-size: 19rpx;
  font-weight: 600;
  letter-spacing: 1rpx;
}

.admin-hub-title {
  margin-top: 4rpx;
  font-size: 30rpx;
  font-weight: 750;
}

.admin-hub-copy {
  margin-top: 7rpx;
  color: rgba(255, 255, 255, 0.76);
  font-size: 20rpx;
  line-height: 1.45;
}

.admin-hub-side {
  position: relative;
  z-index: 1;
  display: flex;
  width: 72rpx;
  flex-shrink: 0;
  flex-direction: column;
  align-items: center;
}

.admin-hub-count {
  font-size: 34rpx;
  font-weight: 800;
  font-variant-numeric: tabular-nums;
}

.admin-hub-unit {
  margin-top: 2rpx;
  color: rgba(255, 255, 255, 0.68);
  font-size: 17rpx;
}

.admin-hub-arrow {
  width: 26rpx;
  height: 26rpx;
  margin-top: 10rpx;
}

.badge-dot {
  width: 12rpx;
  height: 12rpx;
  flex-shrink: 0;
  background: var(--c-danger);
  border-radius: 50%;
}

.badge-count {
  min-width: 30rpx;
  height: 30rpx;
  padding: 0 8rpx;
  color: #ffffff;
  background: var(--c-danger);
  border-radius: var(--r-pill);
  font-size: 17rpx;
  line-height: 30rpx;
  text-align: center;
}

.offline-banner {
  display: flex;
  min-height: 68rpx;
  align-items: center;
  gap: 10rpx;
  padding: 10rpx 18rpx;
  margin-bottom: 14rpx;
  box-sizing: border-box;
  color: #a96714;
  background: rgba(229, 138, 25, 0.09);
  border: 1rpx solid rgba(229, 138, 25, 0.22);
  border-radius: 12rpx;
}

.offline-icon {
  width: 28rpx;
  height: 28rpx;
  flex-shrink: 0;
}

.offline-text {
  font-size: 22rpx;
}

.qr-modal {
  position: fixed;
  z-index: 999;
  top: 0;
  right: 0;
  bottom: 0;
  left: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  padding: 28rpx;
  background: rgba(7, 24, 48, 0.72);
}

.qr-modal-box {
  display: flex;
  width: 540rpx;
  flex-direction: column;
  align-items: center;
  padding: 34rpx;
  box-sizing: border-box;
  background: #ffffff;
  border-radius: 22rpx;
  box-shadow: 0 28rpx 70rpx rgba(0, 0, 0, 0.28);
}

.qr-modal-title {
  margin-bottom: 20rpx;
  color: #132642;
  font-size: 30rpx;
  font-weight: 700;
}

.qr-modal-img {
  width: 380rpx;
  height: 380rpx;
  padding: 10rpx;
  box-sizing: border-box;
}

.qr-modal-tip {
  margin-top: 16rpx;
  color: #667b95;
  font-size: 23rpx;
}

.qr-modal-close {
  margin-top: 14rpx;
  color: #9aa9ba;
  font-size: 21rpx;
}

.theme-dark .identity-strip,
.theme-dark .menu-card {
  background: var(--c-surface-solid);
}

.theme-dark .menu-item {
  border-bottom-color: var(--c-border);
}
