/* 页面基类与主题变量由 app.wxss 提供 */

.page-head { padding: 10rpx 2rpx 24rpx; }
.eyebrow { color: var(--c-primary); font-size: 19rpx; font-weight: 700; letter-spacing: 3rpx; }
.page-title { margin-top: 8rpx; font-size: 44rpx; line-height: 1.08; font-weight: 800; letter-spacing: -2rpx; }
.page-copy { margin-top: 9rpx; font-size: 22rpx; line-height: 1.5; opacity: 0.65; }

.summary-grid {
  display: grid;
  grid-template-columns: repeat(4, 1fr);
  gap: 8rpx;
  margin-bottom: 16rpx;
}

.summary-cell {
  min-height: 104rpx;
  padding: 15rpx 8rpx;
  border-radius: 16rpx;
  text-align: center;
}

.theme-light .summary-cell { background: rgba(255, 255, 255, 0.76); }
.theme-dark .summary-cell { background: rgba(14, 42, 73, 0.86); }
.summary-value { display: block; font-size: 34rpx; font-weight: 800; font-variant-numeric: tabular-nums; }
.summary-value.warn { color: #b97518; }
.summary-label { display: block; margin-top: 5rpx; font-size: 19rpx; opacity: 0.63; }

.filter-panel { padding: 16rpx; }
.search-row {
  min-height: 68rpx;
  display: flex;
  align-items: center;
  padding: 0 16rpx;
  border-radius: 14rpx;
}
.theme-light .search-row { background: #e5f0fc; }
.theme-dark .search-row { background: #0c2948; }
.search-code { margin-right: 12rpx; color: var(--c-primary); font-size: 22rpx; font-weight: 750; }
.search-input { flex: 1; min-width: 0; height: 68rpx; font-size: 24rpx; }
.clear-action {
  min-width: 74rpx;
  min-height: 64rpx;
  display: flex;
  align-items: center;
  justify-content: flex-end;
  color: var(--c-primary);
  font-size: 21rpx;
}
.filter-row { margin-top: 12rpx; display: grid; grid-template-columns: repeat(3, 1fr); gap: 9rpx; }
.filter-control {
  min-height: 64rpx;
  padding: 0 10rpx;
  border-radius: 13rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 21rpx;
  font-weight: 600;
}
.theme-light .filter-control { color: #315b86; background: #edf5fe; }
.theme-dark .filter-control { color: #afd2f2; background: #133452; }

.staff-list { display: flex; flex-direction: column; gap: 12rpx; }
.staff-card { padding: 18rpx; border-radius: 18rpx; }
.theme-light .staff-card { background: rgba(255, 255, 255, 0.78); }
.theme-dark .staff-card { background: rgba(13, 41, 72, 0.88); }
.staff-top { display: flex; align-items: center; gap: 14rpx; }
.staff-avatar {
  width: 58rpx;
  height: 58rpx;
  border-radius: 16rpx;
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
  background: rgba(60, 127, 190, 0.15);
  color: #2d679e;
  font-size: 24rpx;
  font-weight: 800;
}
.staff-main { min-width: 0; flex: 1; }
.staff-title-row { display: flex; align-items: center; gap: 8rpx; flex-wrap: wrap; }
.staff-name { font-size: 27rpx; font-weight: 750; }
.admin-tag,
.inactive-tag { padding: 3rpx 9rpx; border-radius: 7rpx; font-size: 17rpx; font-weight: 700; }
.admin-tag { color: #266295; background: rgba(52, 125, 190, 0.13); }
.inactive-tag { color: #a44b54; background: rgba(190, 68, 80, 0.12); }
.staff-meta { margin-top: 5rpx; font-size: 20rpx; opacity: 0.66; }
.edit-btn {
  margin: 0;
  min-width: 102rpx;
  min-height: 64rpx;
  line-height: 64rpx;
  padding: 0 16rpx;
  border-radius: 13rpx;
  color: #285f96;
  background: rgba(52, 125, 190, 0.12);
  font-size: 22rpx;
  font-weight: 650;
}
.staff-detail-row { margin-top: 14rpx; display: flex; gap: 18rpx; font-size: 19rpx; opacity: 0.58; }
.qualification-line {
  margin-top: 10rpx;
  padding-top: 10rpx;
  border-top: 1rpx solid rgba(108, 143, 181, 0.15);
  font-size: 20rpx;
  line-height: 1.45;
  color: var(--c-primary);
}
.qualification-line.secondary {
  margin-top: 4rpx;
  padding-top: 0;
  border-top: 0;
  color: inherit;
  opacity: 0.66;
}
.load-more { min-height: 72rpx; display: flex; align-items: center; justify-content: center; font-size: 20rpx; opacity: 0.58; }

.loading-card { padding: 20rpx; }
.loading-line { height: 88rpx; margin-bottom: 12rpx; border-radius: 14rpx; opacity: 0.5; }
.theme-light .loading-line { background: #d4e3f3; }
.theme-dark .loading-line { background: #1b446c; }
.empty-card,
.error-card,
.denied-card { padding: 46rpx 24rpx; text-align: center; }
.state-title { font-size: 29rpx; font-weight: 750; }
.state-copy { margin-top: 9rpx; font-size: 21rpx; line-height: 1.5; opacity: 0.65; }
.state-btn {
  margin-top: 24rpx;
  min-height: 70rpx;
  line-height: 70rpx;
  border-radius: 14rpx;
  color: #ffffff;
  background: #285f96;
  font-size: 24rpx;
}

.modal-overlay {
  position: fixed;
  left: 0;
  top: 0;
  right: 0;
  bottom: 0;
  z-index: 900;
  display: flex;
  align-items: flex-end;
  background: rgba(4, 16, 30, 0.62);
}
.editor-sheet {
  width: 100%;
  max-height: 88vh;
  border-radius: 28rpx 28rpx 0 0;
  overflow: hidden;
}
.theme-light .editor-sheet { background: #f2f7fc; }
.theme-dark .editor-sheet { background: #091d34; }
.editor-head {
  padding: 24rpx 26rpx 18rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  border-bottom: 1rpx solid rgba(108, 143, 181, 0.17);
}
.editor-title { font-size: 31rpx; font-weight: 780; }
.editor-copy { margin-top: 5rpx; font-size: 20rpx; opacity: 0.62; }
.close-btn {
  min-width: 82rpx;
  height: 64rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 21rpx;
  opacity: 0.62;
}
.editor-body { max-height: 61vh; padding: 8rpx 26rpx 24rpx; box-sizing: border-box; }
.form-row,
.switch-row {
  min-height: 92rpx;
  display: flex;
  align-items: center;
  justify-content: space-between;
  gap: 20rpx;
  border-bottom: 1rpx solid rgba(108, 143, 181, 0.15);
}
.form-row-column { padding: 20rpx 0; align-items: stretch; flex-direction: column; gap: 10rpx; }
.form-label,
.switch-title { font-size: 24rpx; font-weight: 650; }
.form-control {
  min-width: 230rpx;
  min-height: 64rpx;
  padding: 0 16rpx;
  border-radius: 12rpx;
  display: flex;
  align-items: center;
  justify-content: flex-end;
  font-size: 23rpx;
}
.theme-light .form-control { background: #e5effa; }
.theme-dark .form-control { background: #113150; }
.qualification-input {
  width: 100%;
  min-height: 132rpx;
  padding: 16rpx;
  border-radius: 13rpx;
  box-sizing: border-box;
  font-size: 23rpx;
}
.theme-light .qualification-input { background: #e5effa; }
.theme-dark .qualification-input { background: #113150; }
.form-help,
.switch-copy { margin-top: 4rpx; font-size: 19rpx; opacity: 0.58; }
.switch-row > view:first-child { flex: 1; min-width: 0; }
.editor-footer {
  display: grid;
  grid-template-columns: 1fr 1.4fr;
  gap: 12rpx;
  padding: 16rpx 24rpx calc(18rpx + env(safe-area-inset-bottom));
  border-top: 1rpx solid rgba(108, 143, 181, 0.17);
}
.cancel-btn,
.save-btn {
  margin: 0;
  min-height: 76rpx;
  line-height: 76rpx;
  border-radius: 14rpx;
  font-size: 24rpx;
  font-weight: 650;
}
.cancel-btn { background: rgba(110, 134, 157, 0.14); color: inherit; }
.save-btn { background: #285f96; color: #ffffff; }
