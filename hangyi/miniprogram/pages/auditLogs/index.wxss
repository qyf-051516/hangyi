
/* 主题 / 页面 / 卡片基类由 app.wxss 提供(.page / .card / .t-* / .c-*) */

/* 筛选 */
.filter-card { padding: 14rpx 20rpx; }
.filter-title { font-size: 22rpx; font-weight: 600; margin-bottom: 10rpx; }
.theme-dark .filter-title { color: #9abde3; }
.theme-light .filter-title { color: #3d5270; }
.filter-scroll { overflow: auto; white-space: nowrap; }
.filter-tags { display: flex; gap: 10rpx; }
.filter-tag {
  min-height: 64rpx;
  padding: 0 18rpx;
  display: inline-flex;
  align-items: center;
  border-radius: 20rpx;
  font-size: 20rpx;
  font-weight: 600;
  flex-shrink: 0;
}
.date-filter-row { display: flex; align-items: center; gap: 10rpx; margin-top: 14rpx; flex-wrap: wrap; }
.date-filter,
.date-clear {
  min-height: 64rpx;
  padding: 0 16rpx;
  border-radius: 12rpx;
  display: flex;
  align-items: center;
  font-size: 21rpx;
}
.theme-light .date-filter,
.theme-light .date-clear { background: #e8f2fc; color: #315b86; }
.theme-dark .date-filter,
.theme-dark .date-clear { background: #133452; color: #afd2f2; }
.theme-dark .filter-tag { background: rgba(30, 60, 100, 0.5); color: #9abde3; border: 1rpx solid rgba(84, 170, 255, 0.2); }
.theme-light .filter-tag { background: rgba(224, 238, 252, 0.8); color: #3d5270; border: 1rpx solid rgba(124, 156, 198, 0.2); }
.filter-tag-active { background: rgba(83, 153, 255, 0.2) !important; color: #5399ff !important; border-color: rgba(83, 153, 255, 0.4) !important; }

/* 统计 */
.stats-card { padding: 12rpx 20rpx; display: flex; align-items: center; justify-content: space-between; }
.stats-text { font-size: 22rpx; }
.export-btn {
  min-height: 64rpx;
  line-height: 64rpx;
  padding: 0 20rpx;
  font-size: 22rpx;
  border-radius: 12rpx;
  background: rgba(83, 153, 255, 0.12);
  color: #5399ff;
  border: 1rpx solid rgba(83, 153, 255, 0.3);
  font-weight: 600;
  flex-shrink: 0;
}
.theme-dark .stats-text { color: #9abde3; }
.theme-light .stats-text { color: #3d5270; }

/* 日志卡片 */
.log-card { padding: 16rpx 20rpx; }
.log-header { display: flex; justify-content: space-between; align-items: center; margin-bottom: 8rpx; }
.log-action-badge { font-size: 18rpx; padding: 2rpx 12rpx; border-radius: 8rpx; font-weight: 700; }
.log-action-PUBLISH_SCHEDULE,
.log-action-PUBLISH_SERVICE_SCHEDULE { background: rgba(46, 212, 106, 0.12); color: #2ed46a; border: 1rpx solid rgba(46, 212, 106, 0.25); }
.log-action-AUTO_SCHEDULE,
.log-action-BOOTSTRAP_DATA { background: rgba(83, 153, 255, 0.12); color: #5399ff; border: 1rpx solid rgba(83, 153, 255, 0.25); }
.log-action-REJECT_SWAP,
.log-action-APPROVE_SWAP,
.log-action-APPROVE_SWAP_EXCHANGE { background: rgba(240, 160, 48, 0.12); color: #f0a030; border: 1rpx solid rgba(240, 160, 48, 0.25); }
.log-action-UPDATE_CONFIG { background: rgba(160, 120, 240, 0.12); color: #a078f0; border: 1rpx solid rgba(160, 120, 240, 0.25); }
.log-action-LOGIN,
.log-action-LOGOUT,
.log-action-REGISTER { background: rgba(160, 160, 180, 0.12); color: #999; border: 1rpx solid rgba(160, 160, 180, 0.2); }

.log-time { font-size: 18rpx; }
.theme-dark .log-time { color: #6e9fc9; }
.theme-light .log-time { color: #6e88ad; }
.log-operator { font-size: 24rpx; font-weight: 600; margin-bottom: 4rpx; }
.theme-dark .log-operator { color: #dff6ff; }
.theme-light .log-operator { color: #17355f; }
.log-detail { font-size: 22rpx; line-height: 1.5; }
.theme-dark .log-detail { color: #9abde3; }
.theme-light .log-detail { color: #3d5270; }

/* 加载更多 */
.load-more { text-align: center; padding: 20rpx; }
.load-more-btn { display: inline-block; padding: 0 30rpx; min-height: 64rpx; line-height: 64rpx; font-size: 22rpx; border-radius: 28rpx; background: rgba(83, 153, 255, 0.1); color: #5399ff; border: 1rpx solid rgba(83, 153, 255, 0.2); }

.loading-text { text-align: center; padding: 60rpx 0; font-size: 26rpx; }
.theme-dark .loading-text { color: #9abde3; }
.theme-light .loading-text { color: #3d5270; }

.empty-wrap { text-align: center; padding: 120rpx 0; }
.empty-text { font-size: 26rpx; }
.theme-dark .empty-text { color: #6e9fc9; }
.theme-light .empty-text { color: #6e88ad; }

/* ===== 权限不足提示 ===== */
.denied-card {
  text-align: center;
  padding: 80rpx 40rpx;
  margin-top: 80rpx;
}
.denied-icon { font-size: 80rpx; margin-bottom: 16rpx; }
.denied-title { font-size: 32rpx; font-weight: 600; margin-bottom: 8rpx; }
.denied-sub { font-size: 24rpx; opacity: 0.7; }
.error-card { padding: 42rpx 24rpx; text-align: center; }
.state-btn {
  margin-top: 22rpx;
  min-height: 70rpx;
  line-height: 70rpx;
  border-radius: 14rpx;
  color: #ffffff;
  background: #285f96;
  font-size: 24rpx;
}
.theme-dark .denied-title { color: #dff6ff; }
.theme-light .denied-title { color: #17355f; }
.theme-dark .denied-sub { color: #9abde3; }
.theme-light .denied-sub { color: #3d5270; }
