
/* 主题 / 页面 / 卡片基类由 app.wxss 提供(.page / .card / .t-* / .c-*) */

.head .title {
  font-size: 34rpx;
  font-weight: 700;
}

.head .sub {
  margin-top: 6rpx;
  font-size: 24rpx;
}

.theme-dark .sub {
  color: #9abde3;
}

.theme-light .sub {
  color: #3d5270;
}

.loading-text {
  text-align: center;
  font-size: 28rpx;
}

.error-card {
  border-color: var(--c-danger);
}

.error-text {
  color: var(--c-danger);
  font-size: 24rpx;
  line-height: 1.6;
  text-align: center;
}

.theme-dark .loading-text {
  color: #9abde3;
}

.theme-light .loading-text {
  color: #3d5270;
}

/* 排班条目 */
.schedule-item {
  text-align: left;
}

.schedule-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
}

.flight {
  font-size: 30rpx;
  font-weight: 700;
}

.shift-tag {
  font-size: 22rpx;
  padding: 6rpx 16rpx;
  border-radius: 10rpx;
  font-weight: 600;
}

.theme-dark .shift-tag {
  background: rgba(46, 222, 255, 0.22);
  color: #7fe9ff;
  border: 1rpx solid rgba(77, 232, 255, 0.5);
}

.theme-light .shift-tag {
  background: rgba(83, 153, 255, 0.12);
  color: #245090;
  border: 1rpx solid rgba(83, 153, 255, 0.4);
}

.shift-tag.night {
  border-color: rgba(171, 150, 255, 0.72);
  color: #d2beff;
  background: rgba(120, 96, 255, 0.18);
}

.theme-light .shift-tag.night {
  color: #5b3fbb;
  background: rgba(120, 96, 255, 0.1);
  border: 1rpx solid rgba(120, 96, 255, 0.4);
}

.schedule-body {
  margin-top: 14rpx;
}

.line {
  font-size: 24rpx;
  margin-top: 6rpx;
}

.theme-dark .line {
  color: #b4d6f5;
}

.theme-light .line {
  color: #3d5270;
}

.conflict-line {
  margin-top: 12rpx;
  padding: 12rpx 14rpx;
  color: var(--c-danger);
  background: var(--c-surface-solid);
  border: 1rpx solid var(--c-danger);
  border-radius: 10rpx;
  font-size: 22rpx;
  line-height: 1.5;
}

/* 空状态 */
.empty-card {
  text-align: center;
  padding: 60rpx 20rpx;
}

.empty-icon {
  font-size: 64rpx;
  margin-bottom: 16rpx;
}

.empty-text {
  font-size: 28rpx;
  font-weight: 600;
  margin-bottom: 8rpx;
}

.theme-dark .empty-text {
  color: #dff6ff;
}

.theme-light .empty-text {
  color: #17355f;
}

.empty-sub {
  font-size: 22rpx;
}

.theme-dark .empty-sub {
  color: #9abde3;
}

.theme-light .empty-sub {
  color: #3d5270;
}

/* 确认完成按钮 */
.schedule-actions {
  margin-top: 14rpx;
  display: flex;
  justify-content: flex-end;
}

.complete-btn {
  min-height: 64rpx;
  line-height: 64rpx;
  padding: 0 24rpx;
  font-size: 22rpx;
  border-radius: 12rpx;
  background: rgba(83, 153, 255, 0.12);
  color: #245090;
  border: 1rpx solid rgba(83, 153, 255, 0.4);
}

.theme-dark .complete-btn {
  background: rgba(46, 222, 255, 0.22);
  color: #b8e8ff;
  border: 1rpx solid rgba(77, 232, 255, 0.5);
}

.completed-badge {
  padding: 8rpx 24rpx;
  font-size: 22rpx;
  border-radius: 12rpx;
  background: rgba(46, 180, 100, 0.1);
  color: #1a8a5c;
  border: 1rpx solid rgba(46, 180, 100, 0.35);
}

.pending-badge {
  padding: 8rpx 20rpx;
  color: var(--c-text-muted);
  border: 1rpx solid var(--c-border);
  border-radius: 12rpx;
  font-size: 22rpx;
}

.theme-dark .completed-badge {
  background: rgba(46, 255, 140, 0.15);
  color: #3ee0a0;
  border: 1rpx solid rgba(46, 255, 140, 0.4);
}
